{
  "name": "ProjectKB - Tema Terang Editorial Energi",
  "dataColors": [
    "#1B5E42",
    "#B45309",
    "#0E646E",
    "#B42318",
    "#2F5577",
    "#4C6B2A",
    "#3B4854",
    "#6C7A86"
  ],
  "background": "#FFFFFF",
  "foreground": "#1C252C",
  "tableAccent": "#1B5E42",
  "good": "#1B5E42",
  "neutral": "#B45309",
  "bad": "#B42318",
  "maximum": "#1B5E42",
  "center": "#B45309",
  "minimum": "#B42318",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 13,
      "color": "#1C252C"
    },
    "callout": {
      "fontFace": "DIN",
      "fontSize": 24,
      "color": "#1C252C"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 11,
      "color": "#1C252C"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#47535E"
    }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F7F6F2"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#EAE6DD"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "*": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#D5D0C5"
              }
            },
            "radius": 6
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#1C252C"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 12
          }
        ],
        "subTitle": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#47535E"
              }
            },
            "fontFamily": "Segoe UI",
            "fontSize": 9
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#1C252C"
              }
            },
            "fontFamily": "DIN",
            "fontSize": 24
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#47535E"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 10
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "fontColor": {
              "solid": {
                "color": "#47535E"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "textSize": 9
          }
        ],
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#1C252C"
              }
            },
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontFamily": "Segoe UI",
            "textSize": 10
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#1C252C"
              }
            },
            "backColor": {
              "solid": {
                "color": "#EFECE4"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 10
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#1C252C"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#1C252C"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#FAF9F6"
              }
            },
            "fontFamily": "Segoe UI",
            "fontSize": 9
          }
        ],
        "grid": [
          {
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#D5D0C5"
              }
            },
            "gridVertical": false
          }
        ]
      }
    }
  }
}