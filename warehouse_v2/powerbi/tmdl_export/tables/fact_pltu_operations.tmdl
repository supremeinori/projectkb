				            {"capacity_mw", type number},
				            {"jumlah_unit", Int64.Type},
				            {"activity_generation_mwh", type number},
				            {"capacity_factor_pct", type number},
				            {"emissions_co2e_ton", type number},
				            {"emissions_factor_t_per_mwh", type number},
				            {"cofiring_share_pct", type number},
				            {"biomass_used_ton", type number},
				            {"biomass_electricity_mwh", type number},
				            {"biomass_emissions_tco2", type number}
				        },
				        "en-US"
				    )
				in
