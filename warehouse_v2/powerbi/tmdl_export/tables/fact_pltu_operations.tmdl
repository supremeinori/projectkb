	partition fact_pltu_operations = m
		mode: import
		source =
				let
				    Sumber = Csv.Document(
				        File.Contents(FolderProjectKB & "\warehouse_v2\tables\fact_pltu_operations.csv"),
				        [Delimiter=",", Columns=17, Encoding=65001, QuoteStyle=QuoteStyle.Csv]
				    ),
				    Header = Table.PromoteHeaders(Sumber, [PromoteAllScalars=true]),
				    TipeData = Table.TransformColumnTypes(
				        Header,
				        {
				            {"pltu_fact_id", Int64.Type},
				            {"time_key", Int64.Type},
				            {"location_key", Int64.Type},
				            {"pltu_key", Int64.Type},
				            {"dataset_role", type text},
				            {"kode_sumber", type text},
