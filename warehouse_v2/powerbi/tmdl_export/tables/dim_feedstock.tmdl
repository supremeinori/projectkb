	partition dim_feedstock = m
		mode: import
		source =
				let
				    Sumber = Csv.Document(
				        File.Contents(FolderProjectKB & "\warehouse_v2\tables\dim_feedstock.csv"),
				        [Delimiter=",", Columns=34, Encoding=65001, QuoteStyle=QuoteStyle.Csv]
				    ),
				    Header = Table.PromoteHeaders(Sumber, [PromoteAllScalars=true]),
				    TipeData = Table.TransformColumnTypes(
				        Header,
				        {
				            {"feedstock_key", Int64.Type},
				            {"feedstock_id", type text},
				            {"feedstock_name", type text},
				            {"komoditas_bps", type text},
				            {"basis_produk_primer", type text},
				            {"rpr_primer", type number},
				            {"basis_alternatif_bps", type text},
				            {"rpr_alternatif_bps", type number},
				            {"recoverability_factor", type number},
				            {"moisture_lapangan_pct", type number},
				            {"ash_db", type number},
				            {"vm_db", type number},
				            {"fc_db", type number},
				            {"c_db", type number},
				            {"h_db", type number},
				            {"o_db", type number},
				            {"n_db", type number},
				            {"s_db", type number},
				            {"cl_db_pct", type number},
				            {"alkali_total_db_pct", type number},
				            {"idt_oxidizing_c", type number},
				            {"actual_hhv_db", type number},
				            {"predicted_hhv_prox_db", type number},
				            {"predicted_hhv_full_db", type number},
				            {"predicted_hhv_db", type number},
				            {"effective_lhv_lab_mj_kg", type number},
				            {"effective_lhv_field_mj_kg", type number},
				            {"high_moisture_flag", Int64.Type},
				            {"boiler_status", type text},
				            {"is_boiler_eligible", Int64.Type},
				            {"alkali_chlorine_flag", type text},
				            {"screening_recommendation", type text},
				            {"cluster_id", Int64.Type},
				            {"cluster_label", type text}
				        },
				        "en-US"
				    )
				in
				    TipeData

