	partition dim_conversion_tech = m
		mode: import
		source =
				let
				    Sumber = Csv.Document(
				        File.Contents(FolderProjectKB & "\warehouse_v2\tables\dim_conversion_tech.csv"),
				        [Delimiter=",", Columns=9, Encoding=65001, QuoteStyle=QuoteStyle.Csv]
				    ),
				    Header = Table.PromoteHeaders(Sumber, [PromoteAllScalars=true]),
				    TipeData = Table.TransformColumnTypes(
				        Header,
				        {
				            {"tech_key", Int64.Type},
				            {"tech_code", type text},
				            {"tech_name", type text},
				            {"efficiency_pct", type number},
				            {"capacity_factor_pct", type number},
				            {"operating_hours_per_year", type number},
				            {"ash_limit_pct", type number},
				            {"sulfur_limit_pct", type number},
				            {"reference_note", type text}
				        },
				        "en-US"
				    )
				in
				    TipeData

