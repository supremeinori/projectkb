	partition dim_shap_importance = m
		mode: import
		source =
				let
				    Sumber = Csv.Document(
				        File.Contents(FolderProjectKB & "\warehouse_v2\powerbi\dim_shap_importance.csv"),
				        [Delimiter=",", Columns=8, Encoding=65001, QuoteStyle=QuoteStyle.Csv]
				    ),
				    Header = Table.PromoteHeaders(Sumber, [PromoteAllScalars=true]),
				    TipeData = Table.TransformColumnTypes(
				        Header,
				        {
				            {"scenario_code", type text},
				            {"scenario_label", type text},
				            {"feature_code", type text},
				            {"feature_label_id", type text},
				            {"mean_abs_shap_mj_kg", type number},
				            {"rank_in_scenario", Int64.Type},
				            {"model_algorithm", type text},
				            {"shap_backend", type text}
				        },
				        "en-US"
				    )
				in
				    TipeData

