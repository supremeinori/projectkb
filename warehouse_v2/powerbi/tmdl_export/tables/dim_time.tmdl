	partition dim_time = m
		mode: import
		source =
				let
				    Sumber = Csv.Document(
				        File.Contents(FolderProjectKB & "\warehouse_v2\tables\dim_time.csv"),
				        [Delimiter=",", Columns=7, Encoding=65001, QuoteStyle=QuoteStyle.Csv]
				    ),
				    Header = Table.PromoteHeaders(Sumber, [PromoteAllScalars=true]),
				    TipeData = Table.TransformColumnTypes(
				        Header,
				        {
				            {"time_key", Int64.Type},
				            {"year", Int64.Type},
				            {"decade", Int64.Type},
				            {"is_bps_ksa_era", Int64.Type},
				            {"is_post_papua_split", Int64.Type},
				            {"is_anchor_2022", Int64.Type},
				            {"has_pltu_ct_data", Int64.Type}
				        },
				        "en-US"
				    )
				in
				    TipeData

