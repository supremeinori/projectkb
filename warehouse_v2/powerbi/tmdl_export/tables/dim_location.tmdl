	partition dim_location = m
		mode: import
		source =
				let
				    Sumber = Csv.Document(
				        File.Contents(FolderProjectKB & "\warehouse_v2\tables\dim_location.csv"),
				        [Delimiter=",", Columns=14, Encoding=65001, QuoteStyle=QuoteStyle.Csv]
				    ),
				    Header = Table.PromoteHeaders(Sumber, [PromoteAllScalars=true]),
				    TipeData = Table.TransformColumnTypes(
				        Header,
				        {
				            {"location_key", Int64.Type},
				            {"location_code", type text},
				            {"level_wilayah", type text},
				            {"kode_prov", Int64.Type},
				            {"nama_provinsi", type text},
				            {"kode_kabkota", Int64.Type},
				            {"nama_kabkota", type text},
				            {"pulau", type text},
				            {"masuk_5_pulau_pltu", Int64.Type},
				            {"wilayah_pln", type text},
				            {"latitude_centroid", type number},
				            {"longitude_centroid", type number},
				            {"has_coordinates", Int64.Type},
				            {"is_dob_papua_mapped", Int64.Type}
				        },
				        "en-US"
				    )
				in
				    TipeData

