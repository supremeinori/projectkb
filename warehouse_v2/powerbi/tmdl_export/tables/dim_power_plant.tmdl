	partition dim_power_plant = m
		mode: import
		source =
				let
				    Sumber = Csv.Document(
				        File.Contents(FolderProjectKB & "\warehouse_v2\tables\dim_power_plant.csv"),
				        [Delimiter=",", Columns=18, Encoding=65001, QuoteStyle=QuoteStyle.Csv]
				    ),
				    Header = Table.PromoteHeaders(Sumber, [PromoteAllScalars=true]),
				    TipeData = Table.TransformColumnTypes(
				        Header,
				        {
				            {"pltu_key", Int64.Type},
				            {"pltu_master_id", type text},
				            {"nama_pltu_standar", type text},
				            {"nama_climatetrace", type text},
				            {"nama_wri_gppd", type text},
				            {"nama_crea_2025", type text},
				            {"owner_operator", type text},
				            {"jenis_boiler", type text},
				            {"status_cofiring_2024", type text},
				            {"commissioning_year", Int64.Type},
				            {"latitude", type number},
				            {"longitude", type number},
				            {"has_coordinates", Int64.Type},
				            {"pulau", type text},
				            {"masuk_5_pulau_pltu", Int64.Type},
				            {"wilayah_pln", type text},
				            {"entity_match_method", type text},
				            {"name_audit_flag", type text}
				        },
				        "en-US"
				    )
				in
				    TipeData

