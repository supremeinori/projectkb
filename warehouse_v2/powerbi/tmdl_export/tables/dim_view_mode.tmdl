	partition dim_view_mode = m
		mode: import
		source =
				let
				    Sumber = Csv.Document(
				        File.Contents(FolderProjectKB & "\warehouse_v2\powerbi\dim_view_mode.csv"),
				        [Delimiter=",", Columns=6, Encoding=65001, QuoteStyle=QuoteStyle.Csv]
				    ),
				    Header = Table.PromoteHeaders(Sumber, [PromoteAllScalars=true]),
				    TipeData = Table.TransformColumnTypes(
				        Header,
				        {
				            {"view_mode_key", Int64.Type},
				            {"view_mode_code", type text},
				            {"view_mode_label", type text},
				            {"pltu_reference_year", Int64.Type},
				            {"sort_order", Int64.Type},
				            {"scope_note_id", type text}
				        },
				        "en-US"
				    )
				in
				    TipeData

